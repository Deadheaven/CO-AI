# Browser-visible Supabase configuration only. The anon/publishable key is
# intended for client use; never put service-role, Nebius, or GitHub secrets here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Public DNS name pointing at the Nebius VM. Caddy provisions HTTPS.
COAI_DOMAIN=coai.example.com
